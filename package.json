{
  "name": "brawl-meta-tw",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "npm run build-only && wrangler dev",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "assets:icons": "node scripts/generate-icons.mjs",
    "data:meta": "node scripts/fetch-static-data.mjs",
    "deploy": "npm run build-only && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/noto-sans-tc": "^5.2.9",
    "@fontsource/oswald": "^5.2.8",
    "@lucide/vue": "^1.16.0",
    "@tailwindcss/vite": "^4.3.0",
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.32",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.40.2",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^8.0.4",
    "sharp": "^0.34.5",
    "typescript": "~6.0.0",
    "vite": "^8.0.8",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vue-tsc": "^3.2.6",
    "wrangler": "^4.100.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
